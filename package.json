{
  "name": "agent-review-kit",
  "version": "0.1.0",
  "description": "Local diff review server for Codex and Claude Code sessions: generate a GitHub-like review HTML, collect inline comments, and feed them back to the agent",
  "license": "MIT",
  "bin": {
    "agent-review-kit": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && cp src/client/style.css dist/client/",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint src",
    "test": "npm run build:client && tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "eslint": "9.39.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0"
  },
  "dependencies": {
    "shiki": "3.23.0"
  }
}
