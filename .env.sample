# agent-review-kit の設定デフォルト（人ごとの初期値）
#
# 使い方: ホームディレクトリの ~/.agent-review/.env にコピーする（全リポジトリ共通）
#   mkdir -p ~/.agent-review && cp .env.sample ~/.agent-review/.env
#
# 優先順位: settings.json の明示値 > .env > 組み込みデフォルト
# （ブラウザの歯車メニューで一度変更すると settings.json に確定し、
#   以降そのブランチには .env の変更は反映されない）
#
# bool は true/false/1/0 のみ有効。それ以外の値は無視され組み込みデフォルトに落ちる。
# 値は以下がすべて組み込みデフォルト。変えたい行だけ残せばよい。

# 修正スナップショット（コメントごとの修正差分ページ）を保存するか
ARK_SNAPSHOTS_ENABLED=true

# 読み取り専用モード（他人の MR レビューなど、コードを変更しない）
ARK_READ_ONLY_MODE=false

# 差分が変わったファイルの Viewed（確認済み）を自動解除するか
ARK_VIEWED_AUTO_RESET=true

# wait-comments の受信出力に処理指示の note を同乗させるか
ARK_DELIVERY_NOTE_ENABLED=false

# note の本文（"..." 内の \n は改行になる）。空文字にすると note 自体を送らない。
# 以下が組み込みデフォルト（委譲指示）。書き換えれば任意の指示に差し替えられる
ARK_DELIVERY_NOTE_TEXT="修正を伴うコメントは、メインセッションで直接コードを編集せず、Agent ツールでサブエージェントに委譲すること（1件だけでも委譲する）。複数件ある場合は1つのメッセージで並行起動し、完了を待たずに次のコメントの委譲へ進む。メインセッションは委譲・回答・対応記録（resolve-comment）のオーケストレーションに徹する。"
